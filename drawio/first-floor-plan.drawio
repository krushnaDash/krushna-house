arent="plan-3bhk-dims"><mxGeometry relative="1" as="geometry"><mxPoint x="1382.00" y="960.00" as="sourcePoint"/><mxPoint x="1382.00" y="991.20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="bubble-D" value="D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#1F2D3D;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-dims"><mxGeometry x="1369.00" y="991.20" width="26.00" height="26.00" as="geometry"/></mxCell><mxCell id="title" value="First-Floor Plan – Kutpali House · Option B: 3 BHK (internal door open)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=24;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="230.00" y="14.00" width="1500.00" height="34.00" as="geometry"/></mxCell><mxCell id="subtitle" value="Roof 48′-0″ × 30′-0″ · pillars 10″ × 10″ FIXED (locked, same positions as the rooftop file) · walls 10″ / partitions 4½″ · room sizes are clear sizes · scale 1 ft = 24 px, grid 6″ · furniture indicative" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=13;fontStyle=0;fontColor=#555555;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="230.00" y="48.00" width="1600.00" height="22.00" as="geometry"/></mxCell><mxCell id="v69" value="" style="rounded=0;html=1;fillColor=#1F2D3D;strokeColor=#000000;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="230.00" y="1060.00" width="20.00" height="20.00" as="geometry"/></mxCell><mxCell id="v70" value="Pillar (locked)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="256.00" y="1060.00" width="120.00" height="20.00" as="geometry"/></mxCell><mxCell id="v71" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#7B8189;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="380.00" y="1064.00" width="40.00" height="12.00" as="geometry"/></mxCell><mxCell id="v72" value="Wall 10″" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="426.00" y="1060.00" width="100.00" height="20.00" as="geometry"/></mxCell><mxCell id="v73" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#B3B8BE;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="520.00" y="1067.00" width="40.00" height="6.00" as="geometry"/></mxCell><mxCell id="v74" value="Partition 4½″" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="566.00" y="1060.00" width="100.00" height="20.00" as="geometry"/></mxCell><mxCell id="v75" value="" style="shape=mxgraph.floorplan.doorRight;html=1;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="680.00" y="1056.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="v76" value="Door" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="714.00" y="1060.00" width="60.00" height="20.00" as="geometry"/></mxCell><mxCell id="v77" value="" style="shape=mxgraph.floorplan.window;html=1;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="780.00" y="1065.00" width="40.00" height="10.00" as="geometry"/></mxCell><mxCell id="v78" value="Window" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="826.00" y="1060.00" width="70.00" height="20.00" as="geometry"/></mxCell><mxCell id="v79" value="" style="shape=mxgraph.floorplan.doorRight;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="910.00" y="1056.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="v80" value="Connecting door (OPEN → 3 BHK)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="944.00" y="1060.00" width="330.00" height="20.00" as="geometry"/></mxCell><mxCell id="schedule" value="&lt;b&gt;Room schedule – 3 BHK carpet area&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr style=&quot;background-color:#E8EEF7;&quot;&gt;&lt;th align=&quot;left&quot;&gt;Room&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Clear size&lt;/th&gt;&lt;th&gt;sq ft&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MASTER BEDROOM&lt;/td&gt;&lt;td&gt;12′-4″ × 12′-0″ + 4′-4″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;168&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 1&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 2&lt;/td&gt;&lt;td&gt;12′-10″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;154&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIVING / DINING&lt;/td&gt;&lt;td&gt;17′-0″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;204&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KITCHEN&lt;/td&gt;&lt;td&gt;8′-2″ × 8′-2″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;66&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 2&lt;/td&gt;&lt;td&gt;4′-0″ × 8′-2″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;32&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PASSAGE&lt;/td&gt;&lt;td&gt;12′-10″ × 3′-6″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;45&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 3&lt;/td&gt;&lt;td&gt;9′-6″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;95&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PANTRY / UTILITY&lt;/td&gt;&lt;td&gt;6′-2″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FAMILY LOUNGE&lt;/td&gt;&lt;td&gt;11′-8″ × 10′-0″ + 4′-4″ × 2′-4″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;127&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 3&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-3″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;29&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BALCONY&lt;/td&gt;&lt;td&gt;16′-0″ × 3′-10″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;3 BHK total (excl. balcony)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;b&gt;1010&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="230.00" y="1110.00" width="640.00" height="520.00" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;What changes when merged&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Connecting door OPEN&lt;/b&gt; (green) – the two living rooms become one long living / lounge space.&lt;br&gt;• 1 BHK living → &lt;b&gt;Family lounge&lt;/b&gt; · 1 BHK bedroom → &lt;b&gt;Bedroom 3&lt;/b&gt; · 1 BHK bath → &lt;b&gt;Bath 3&lt;/b&gt; · 1 BHK kitchen → &lt;b&gt;Pantry / utility&lt;/b&gt; (keep plumbing and hob point).&lt;br&gt;② 2 BHK door = &lt;b&gt;main entrance&lt;/b&gt; · ③ 1 BHK door = 2nd entrance, kept locked.&lt;br&gt;④ Existing stair (position assumed) · ⑤ balcony off Bedroom 3 and the pantry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;• Two electricity meters and two water lines at the gallery wall stay; in 3 BHK use one set, leave the other idle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Same structure as page 1&lt;/b&gt;&lt;br&gt;• Pillars and walls unchanged – only the connecting door is opened and rooms are re-named. No wall is demolished, so the merge is reversible.&lt;br&gt;• Engineer notes on page 1 apply." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="plan-3bhk-notes"><mxGeometry x="920.00" y="1110.00" width="800.00" height="520.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>