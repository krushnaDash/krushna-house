as="geometry"/></mxCell><mxCell id="v74" value="Partition 4½″" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-notes"><mxGeometry x="566.00" y="1060.00" width="100.00" height="20.00" as="geometry"/></mxCell><mxCell id="v75" value="" style="shape=mxgraph.floorplan.doorRight;html=1;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="plan-sep-notes"><mxGeometry x="680.00" y="1056.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="v76" value="Door" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-notes"><mxGeometry x="714.00" y="1060.00" width="60.00" height="20.00" as="geometry"/></mxCell><mxCell id="v77" value="" style="shape=mxgraph.floorplan.window;html=1;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="plan-sep-notes"><mxGeometry x="780.00" y="1065.00" width="40.00" height="10.00" as="geometry"/></mxCell><mxCell id="v78" value="Window" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-notes"><mxGeometry x="826.00" y="1060.00" width="70.00" height="20.00" as="geometry"/></mxCell><mxCell id="v79" value="" style="shape=mxgraph.floorplan.doorRight;html=1;fillColor=#FFFFFF;strokeColor=#C62828;" vertex="1" parent="plan-sep-notes"><mxGeometry x="910.00" y="1056.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="v80" value="Connecting door (LOCKED – open it to make 3 BHK)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-notes"><mxGeometry x="944.00" y="1060.00" width="330.00" height="20.00" as="geometry"/></mxCell><mxCell id="schedule" value="&lt;b&gt;Room schedule – carpet area&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr style=&quot;background-color:#E8EEF7;&quot;&gt;&lt;th align=&quot;left&quot;&gt;Room&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Clear size&lt;/th&gt;&lt;th&gt;sq ft&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#E3EEF9;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;&lt;b&gt;2 BHK&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MASTER BEDROOM&lt;/td&gt;&lt;td&gt;12′-4″ × 12′-0″ + 4′-4″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;168&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 1&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 2&lt;/td&gt;&lt;td&gt;12′-10″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;154&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIVING / DINING&lt;/td&gt;&lt;td&gt;17′-0″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;204&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KITCHEN&lt;/td&gt;&lt;td&gt;8′-2″ × 8′-2″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;66&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 2&lt;/td&gt;&lt;td&gt;4′-0″ × 8′-2″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;32&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PASSAGE&lt;/td&gt;&lt;td&gt;12′-10″ × 3′-6″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;45&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2 BHK total&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;b&gt;698&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FBE9D2;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;&lt;b&gt;1 BHK&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM&lt;/td&gt;&lt;td&gt;9′-6″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;95&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KITCHEN&lt;/td&gt;&lt;td&gt;6′-2″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIVING&lt;/td&gt;&lt;td&gt;11′-8″ × 10′-0″ + 4′-4″ × 2′-4″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;127&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-3″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;29&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BALCONY&lt;/td&gt;&lt;td&gt;16′-0″ × 3′-10″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1 BHK total (excl. balcony)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;b&gt;311&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-notes"><mxGeometry x="230.00" y="1110.00" width="640.00" height="520.00" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Reading this plan&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Connecting door&lt;/b&gt; – 3′-0″ in the 10″ party wall on the C line, centred between C2 and C3, joining the two living rooms. &lt;b&gt;Locked (bolt each side)&lt;/b&gt; here; open it = page 2 (3 BHK).&lt;br&gt;② &lt;b&gt;2 BHK entrance&lt;/b&gt; and ③ &lt;b&gt;1 BHK entrance&lt;/b&gt; – both off the shared 4′ front gallery; doors swing inward.&lt;br&gt;④ &lt;b&gt;Existing stair&lt;/b&gt; – lands at the D3 (east) end of the gallery; dashed = position assumed.&lt;br&gt;⑤ &lt;b&gt;Balcony&lt;/b&gt; – back 4′ strip above C1–D1, for the 1 BHK.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules applied&lt;/b&gt;&lt;br&gt;• Left 4′ strip (highway): Bath 1 + Bath 2 + windows only – no balcony.&lt;br&gt;• Every pillar sits inside a wall; C1–C3 in the party wall, A2/B2 in the 9″ wall on the A2–B2 row.&lt;br&gt;• Every habitable room has an external window; Bath 2 opens off the passage, never through a bedroom.&lt;br&gt;&lt;br&gt;&lt;b&gt;Engineer to confirm&lt;/b&gt;&lt;br&gt;• Left, front and back 4′ strips are cantilevers: they carry the west wall, Bath 1/2, the gallery parapet and the balcony. Check load, sunken slab + waterproofing in baths; lighter wall (6″ AAC) possible on the tip.&lt;br&gt;• Slab/beam layout and floor height not given; check bye-laws (highway setback, ventilation, single-stair egress)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-notes"><mxGeometry x="920.00" y="1110.00" width="800.00" height="520.00" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="plan-3bhk" name="3 BHK (merged)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="12" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1750" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="plan-3bhk-floor" value="Floor tints (locked)" style="locked=1;" parent="0"/><mxCell id="plan-3bhk-struct" value="Structure – pillars (locked) + walls" parent="0"/><mxCell id="plan-3bhk-open" value="Doors &amp; windows" parent="0"/><mxCell id="plan-3bhk-furn" value="Furniture &amp; fixtures (indicative)" parent="0"/><mxCell id="plan-3bhk-label" value="Room labels" parent="0"/><mxCell id="plan-3bhk-dims" value="Dimensions &amp; grid" parent="0"/><mxCell id="plan-3bhk-notes" value="Title, legend, schedule, notes" parent="0"/><mxCell id="tint-2bhk" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="plan-3bhk-floor"><mxGeometry x="250.00" y="250.00" width="718.00" height="594.00" as="geometry"/></mxCell><mxCell id="tint-1bhk" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="plan-3bhk-floor"><mxGeometry x="988.00" y="356.00"