;dashed=1;dashPattern=12 4 2 4;" edge="1" parent="plan-sep-dims"><mxGeometry relative="1" as="geometry"><mxPoint x="656.00" y="960.00" as="sourcePoint"/><mxPoint x="656.00" y="991.20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="bubble-B" value="B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#1F2D3D;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-dims"><mxGeometry x="643.00" y="991.20" width="26.00" height="26.00" as="geometry"/></mxCell><mxCell id="e67" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#7C9CC0;strokeWidth=1;dashed=1;dashPattern=12 4 2 4;" edge="1" parent="plan-sep-dims"><mxGeometry relative="1" as="geometry"><mxPoint x="978.00" y="960.00" as="sourcePoint"/><mxPoint x="978.00" y="991.20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="bubble-C" value="C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#1F2D3D;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-dims"><mxGeometry x="965.00" y="991.20" width="26.00" height="26.00" as="geometry"/></mxCell><mxCell id="e68" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#7C9CC0;strokeWidth=1;dashed=1;dashPattern=12 4 2 4;" edge="1" parent="plan-sep-dims"><mxGeometry relative="1" as="geometry"><mxPoint x="1382.00" y="960.00" as="sourcePoint"/><mxPoint x="1382.00" y="991.20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="bubble-D" value="D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#1F2D3D;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="plan-sep-dims"><mxGeometry x="1369.00" y="991.20" width="26.00" height="26.00" as="geometry"/></mxCell><mxCell id="title" value="First-Floor Plan – Kutpali House · Option A: 1 BHK + 2 BHK (separate homes)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSp