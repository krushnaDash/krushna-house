t="1"><mxGeometry x="1338.40" y="570.60" width="32.00" height="18.00" as="geometry"/></mxCell><mxCell id="v190" value="D3" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=13;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="1338.40" y="824.60" width="32.00" height="18.00" as="geometry"/></mxCell><mxCell id="title" value="Rooftop Pillar Layout – Kutpali House" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=24;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="230.00" y="14.00" width="1150.00" height="34.00" as="geometry"/></mxCell><mxCell id="subtitle" value="Roof 48′-0″ × 30′-0″ · 12 pillars, 10″ × 10″ · clear distances between faces, feet-inches · pillar positions are FIXED (locked in this file) · scale 1 ft = 24 px, grid 12 px = 6″" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=13;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="230.00" y="48.00" width="1400.00" height="22.00" as="geometry"/></mxCell><mxCell id="lg-pillar" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2D3D;strokeColor=#000000;locked=1;" vertex="1" parent="1"><mxGeometry x="230.00" y="1058.00" width="20.00" height="20.00" as="geometry"/></mxCell><mxCell id="v191" value="Pillar 10″×10″ (locked)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="258.00" y="1058.00" width="190.00" height="20.00" as="geometry"/></mxCell><mxCell id="e192" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#7C9CC0;strokeWidth=1;dashed=1;dashPattern=12 4 2 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470.00" y="1068.00" as="sourcePoint"/><mxPoint x="520.00" y="1068.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v193" value="Column grid line" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="526.00" y="1058.00" width="120.00" height="20.00" as="geometry"/></mxCell><mxCell id="e194" value="" style="endArrow=classic;startArrow=classic;endFill=1;startFill=1;endSize=5;startSize=5;html=1;rounded=0;strokeColor=#0B5FA5;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670.00" y="1068.00" as="sourcePoint"/><mxPoint x="720.00" y="1068.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v195" value="Dimension – clear distance between faces / edge extension" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="726.00" y="1058.00" width="420.00" height="20.00" as="geometry"/></mxCell><mxCell id="coord-table" value="&lt;b&gt;Pillar centres (from top-left corner of roof outline)&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr style=&quot;background-color:#E8EEF7;&quot;&gt;&lt;th align=&quot;left&quot;&gt;Pillar&lt;/th&gt;&lt;th&gt;x (from left edge)&lt;/th&gt;&lt;th&gt;y (from top edge)&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Basis&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;A1&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;4′-5″ &lt;span style=&quot;color:#777;&quot;&gt;(4.42)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;0″ &lt;span style=&quot;color:#777;&quot;&gt;(0.00)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;4′-0″ clear from left edge; centred on top edge&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;A2&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;4′-5″ &lt;span style=&quot;color:#777;&quot;&gt;(4.42)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;12′-9½″ &lt;span style=&quot;color:#777;&quot;&gt;(12.79)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;midway A1–A3: two equal gaps of 11′-11½″ clear (sketch 13′-0″ c/c)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;A3&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;4′-5″ &lt;span style=&quot;color:#777;&quot;&gt;(4.42)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;25′-7″ &lt;span style=&quot;color:#777;&quot;&gt;(25.58)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;bottom face 4′-0″ above bottom edge (sketch label 26 = bottom face)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;B1&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;17′-9″ &lt;span style=&quot;color:#777;&quot;&gt;(17.75)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;0″ &lt;span style=&quot;color:#777;&quot;&gt;(0.00)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;12′-6″ clear from A1; centred on top edge&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;B2&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;17′-9″ &lt;span style=&quot;color:#777;&quot;&gt;(17.75)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;12′-9½″ &lt;span style=&quot;color:#777;&quot;&gt;(12.79)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;12′-6″ clear from A2; same row as A2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;B3&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;17′-9″ &lt;span style=&quot;color:#777;&quot;&gt;(17.75)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;25′-7″ &lt;span style=&quot;color:#777;&quot;&gt;(25.58)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;12′-6″ clear from A3; same row as A3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;C1&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;31′-2″ &lt;span style=&quot;color:#777;&quot;&gt;(31.17)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;4′-5″ &lt;span style=&quot;color:#777;&quot;&gt;(4.42)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;13′-0″ from B-line; 16′-0″ to D1; top face 4′-0″ below top edge&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;C2&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;31′-2″ &lt;span style=&quot;color:#777;&quot;&gt;(31.17)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;15′-0″ &lt;span style=&quot;color:#777;&quot;&gt;(15.00)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;9′-9″ clear below C1 (equal-gap rule; sketch 10′-6″ c/c)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;C3&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;31′-2″ &lt;span style=&quot;color:#777;&quot;&gt;(31.17)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;25′-7″ &lt;span style=&quot;color:#777;&quot;&gt;(25.58)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;12′-6″ clear from B3; 9′-9″ clear below C2; bottom face 4′-0″ above bottom edge&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;D1&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;48′-0″ &lt;span style=&quot;color:#777;&quot;&gt;(48.00)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;4′-5″ &lt;span style=&quot;color:#777;&quot;&gt;(4.42)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;same row as C1; 16′-0″ clear from C1; centred on right edge; label 4.5 = 4′-5″&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;D2&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;48′-0″ &lt;span style=&quot;color:#777;&quot;&gt;(48.00)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;15′-0″ &lt;span style=&quot;color:#777;&quot;&gt;(15.00)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;same row as C2; sketch label 15.5 = bottom face 15′-5″&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;D3&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;48′-0″ &lt;span style=&quot;color:#777;&quot;&gt;(48.00)&lt;/span&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;25′-7″ &lt;span style=&quot;color:#777;&quot;&gt;(25.58)&lt;/span&gt;&lt;/td&gt;&lt;td&gt;same row as C3; sketch label 26 = bottom face 26′-0″&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="230.00" y="1110.00" width="760.00" height="340.00" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Rule used&lt;/b&gt;&lt;br&gt;• Origin = top-left corner of roof outline; x → right, y ↓. Sketch “12.6 / 10.6” = 12′-6″ / 10′-6″ (confirmed).&lt;br&gt;• Extension = 4′-0″ from pillar face to roof edge (left, top for C/D, bottom).&lt;br&gt;• C/D columns: 30′-0″ − (4′-0″ + 4′-0″) = 22′-0″ = 3 × 10″ + 2 gaps → each gap 9′-9″ clear (centres 4′-5″ / 15′-0″ / 25′-7″). C-n and D-n share rows; column C is straight at x = 31′-2″.&lt;br&gt;• A/B columns: same rule with A1/B1 centred on the top edge → 2 gaps of 11′-11½″ clear (centres 0 / 12′-9½″ / 25′-7″). A-n and B-n share rows; bottom row A3–D3 is one straight line.&lt;br&gt;• Horizontal dims are clear distances; exception “13′-0″” runs from the B grid line to the C1 face.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cross-check with your sketch&lt;/b&gt;&lt;br&gt;• D2 / D3 labels “15.5” / “26” = bottom faces 15′-5″ / 26′-0″ ✓ exact · D1 “4.5” = centre 4′-5″ ✓&lt;br&gt;• “10.6” spans = c/c 10′-7″ ✓ (1″) · “13” spans = c/c 12′-9½″ ✓ (2½″) · bottom B3→C3 clear 12′-7″ vs sketch 12′-6″ (1″)&lt;br&gt;• Width: top row 4′-0″ + 10″ + 12′-6″ + 5″ + 13′-0″ + 10″ + 16′-0″ + 5″ = 48′-0″ ✓; bottom row 47′-11″ ✓ (1″ short)&lt;br&gt;• Depth C/D: 4′-0″ + 3 × 10″ + 2 × 9′-9″ + 4′-0″ = 30′-0″ ✓ · A/B: 5″ + 2 × 11′-11½″ + 2 × 10″ + 4′-0″ = 30′-0″ ✓&lt;br&gt;• B-line to right edge 30′-3″ ✓ (sketch 30 ft) · C1 centre → D1 face 16′-5″ ✓ (sketch 16.5)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tape-check on site&lt;/b&gt;&lt;br&gt;1. A1, B1 centred on the top edge, and D1–D3 centred on the right edge?&lt;br&gt;2. A3, B3, C3, D3 in one straight row, bottom faces 4′-0″ above the bottom edge?&lt;br&gt;3. A1→A2 centre to centre: 12′-9½″ here, the sketch said 13′-0″." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1020.00" y="1110.00" width="700.00" height="420.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>