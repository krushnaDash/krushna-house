id="v86" value="" style="shape=mxgraph.floorplan.doorRight;html=1;fillColor=#FFFFFF;strokeColor=#0B5FA5;strokeWidth=2;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="1290.00" y="1056.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="v87" value="Entrance doors (blue = main · grey = 2nd, locked)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="1324.00" y="1060.00" width="330.00" height="20.00" as="geometry"/></mxCell><mxCell id="schedule" value="&lt;b&gt;Room schedule – carpet area&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr style=&quot;background-color:#E8EEF7;&quot;&gt;&lt;th align=&quot;left&quot;&gt;Room&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Clear size&lt;/th&gt;&lt;th&gt;sq ft&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MASTER BEDROOM&lt;/td&gt;&lt;td&gt;12′-4″ × 12′-0″ + 4′-4″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;168&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 1&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 2&lt;/td&gt;&lt;td&gt;12′-10″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;154&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIVING / DINING&lt;/td&gt;&lt;td&gt;16′-2″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;194&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LOBBY&lt;/td&gt;&lt;td&gt;4′-10″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;23&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KITCHEN&lt;/td&gt;&lt;td&gt;8′-6″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;102&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 2&lt;/td&gt;&lt;td&gt;4′-6″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 3&lt;/td&gt;&lt;td&gt;9′-6″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;95&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PANTRY / UTILITY&lt;/td&gt;&lt;td&gt;6′-2″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FAMILY LOUNGE&lt;/td&gt;&lt;td&gt;11′-8″ × 10′-0″ + 4′-4″ × 2′-4″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;127&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 3&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-3″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;29&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BALCONY&lt;/td&gt;&lt;td&gt;16′-0″ × 3′-10″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Total (excl. balcony)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;b&gt;1011&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="230.00" y="1110.00" width="640.00" height="560.00" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;What changes when merged&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Connecting door OPEN&lt;/b&gt; (green) – the two living rooms become one long living / lounge space.&lt;br&gt;• 1 BHK living → &lt;b&gt;Family lounge&lt;/b&gt; · bedroom → &lt;b&gt;Bedroom 3&lt;/b&gt; · bath → &lt;b&gt;Bath 3&lt;/b&gt; · kitchen → &lt;b&gt;Pantry / utility&lt;/b&gt; (keep plumbing and hob point).&lt;br&gt;② 2 BHK door = &lt;b&gt;main entrance&lt;/b&gt; · ③ 1 BHK door = 2nd entrance, kept locked.&lt;br&gt;⑥ Lobby and ⑦ west-end kitchen as on page 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;• Two electricity meters and two water lines at the gallery wall stay; in the 3 BHK use one set, leave the other idle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Same structure as page 1&lt;/b&gt;&lt;br&gt;• Pillars and walls unchanged – only the connecting door is opened and rooms are re-named. No wall is demolished, so the merge is reversible.&lt;br&gt;• Merged total 1011 sq ft (excl. balcony) with two kitchens (one becomes a pantry)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="920.00" y="1110.00" width="800.00" height="560.00" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="D-sep" name="D · 1 BHK west + 2 BHK east"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="12" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1750" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="D-sep-floor" value="Floor tints (locked)" style="locked=1;" parent="0"/><mxCell id="D-sep-struct" value="Structure – pillars (locked) + walls" parent="0"/><mxCell id="D-sep-open" value="Doors &amp; windows" parent="0"/><mxCell id="D-sep-furn" value="Furniture &amp; fixtures (indicative)" parent="0"/><mxCell id="D-sep-label" value="Room labels" parent="0"/><mxCell id="D-sep-dims" value="Dimensions &amp; grid" parent="0"/><mxCell id="D-sep-notes" value="Title, legend, schedule, notes" parent="0"/><mxCell id="tint-BED-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FBE9D2;" vertex="1" parent="D-sep-floor"><mxGeometry x="350.50" y="240.00" width="305.50" height="307.00" as="geometry"/></mxCell><mxCell id="tint-BED-1" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FBE9D2;" vertex="1" parent="D-sep-floor"><mxGeometry x="240.00" y="422.50" width="115.00" height="124.50" as="geometry"/></mxCell><mxCell id="tint-BATH-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FBE9D2;" vertex="1" parent="D-sep-floor"><mxGeometry x="240.00" y="240.00" width="110.50" height="182.50" as="geometry"/></mxCell><mxC