whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="C-sep-notes"><mxGeometry x="944.00" y="1060.00" width="330.00" height="20.00" as="geometry"/></mxCell><mxCell id="v86" value="" style="shape=mxgraph.floorplan.doorRight;html=1;fillColor=#FFFFFF;strokeColor=#0B5FA5;strokeWidth=2;" vertex="1" parent="C-sep-notes"><mxGeometry x="1290.00" y="1056.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="v87" value="Entrance doors (blue = 2 BHK · orange = 1 BHK)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="C-sep-notes"><mxGeometry x="1324.00" y="1060.00" width="330.00" height="20.00" as="geometry"/></mxCell><mxCell id="schedule" value="&lt;b&gt;Room schedule – carpet area&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr style=&quot;background-color:#E8EEF7;&quot;&gt;&lt;th align=&quot;left&quot;&gt;Room&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Clear size&lt;/th&gt;&lt;th&gt;sq ft&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#E3EEF9;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;&lt;b&gt;2 BHK&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MASTER BEDROOM&lt;/td&gt;&lt;td&gt;12′-4″ × 12′-0″ + 4′-4″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;168&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 1&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 2&lt;/td&gt;&lt;td&gt;12′-10″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;154&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIVING / DINING&lt;/td&gt;&lt;td&gt;16′-2″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;194&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LOBBY&lt;/td&gt;&lt;td&gt;4′-10″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;23&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KITCHEN&lt;/td&gt;&lt;td&gt;8′-6″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;102&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 2&lt;/td&gt;&lt;td&gt;4′-6″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2 BHK total (excl. balcony)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;b&gt;700&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#FBE9D2;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;&lt;b&gt;1 BHK&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM&lt;/td&gt;&lt;td&gt;9′-6″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;95&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KITCHEN&lt;/td&gt;&lt;td&gt;6′-2″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIVING&lt;/td&gt;&lt;td&gt;11′-8″ × 10′-0″ + 4′-4″ × 2′-4″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;127&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-3″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;29&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BALCONY&lt;/td&gt;&lt;td&gt;16′-0″ × 3′-10″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1 BHK total (excl. balcony)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;b&gt;311&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="C-sep-notes"><mxGeometry x="230.00" y="1110.00" width="640.00" height="560.00" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;What changed from plan A&lt;/b&gt;&lt;br&gt;⑥ &lt;b&gt;Passage removed.&lt;/b&gt; The 45 sq ft corridor (red in your mark-up) is gone. What is left is a 23 sq ft lobby: the landing in front of the master, kitchen and Bath 2 doors. It is open to the living/dining, so it counts as floor, not corridor.&lt;br&gt;⑦ &lt;b&gt;Kitchen at the west end&lt;/b&gt; – 102 sq ft (was 66), window on the highway wall, wet wall shared with Bath 2.&lt;br&gt;• &lt;b&gt;Bath 2 sits between the kitchen and the living/dining&lt;/b&gt;; its door opens onto the lobby, so it never faces the dining table.&lt;br&gt;• 2 BHK 700 sq ft (plan A 698) · 1 BHK 311 sq ft (plan A 311) – same split, same pillars.&lt;br&gt;• 1 BHK: bedroom door moved to the west end of its partition so the TV unit no longer stands in front of it (plan A has that clash).&lt;br&gt;&lt;br&gt;&lt;b&gt;Reading this plan&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Connecting door&lt;/b&gt; – 3′-0″ in the C-line party wall between the two living rooms. &lt;b&gt;Locked&lt;/b&gt; here; open it = page 2 (3 BHK).&lt;br&gt;② 2 BHK entrance · ③ 1 BHK entrance – both off the shared 4′ gallery, doors swing inward.&lt;br&gt;④ Existing stair – lands at the east (D3) end of the gallery; dashed = position assumed.&lt;br&gt;⑤ Balcony – back strip above C1–D1, for the 1 BHK.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules kept&lt;/b&gt;&lt;br&gt;• Left 4′ strip = baths, kitchen and windows only – no balcony.&lt;br&gt;• Every pillar sits inside a wall; every habitable room has an external window.&lt;br&gt;• Bath 2 opens off the lobby, never through a bedroom. Model check: no door clashes, no furniture in door swings.&lt;br&gt;&lt;br&gt;&lt;b&gt;Engineer to confirm&lt;/b&gt; – same cantilever, waterproofing and bye-law points as plan A." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="C-sep-notes"><mxGeometry x="920.00" y="1110.00" width="800.00" height="560.00" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="C-3bhk" name="C · 3 BHK (merged)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="12" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1750" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="C-3bhk-floor" value="Floor tints (locked)" style="locked=1;" parent="0"/><mxCell id="C-3bhk-struct" value="Structure – pillars (locked) + walls" parent="0"/><mxCell id="C-3bhk-open" value="Doors &amp; windows" parent="0"/><mxCell id="C-3bhk-furn" value="Furniture &amp; fixtures (indicative)" parent="0"/><mxCell id="C-3bhk-label" value="Room labels" parent="0"/><mxCell id="C-3bhk-dims" value="Dimensions &amp; grid" parent="0"/><mxCell id="C-3bhk-notes" value="Title, legend, schedule, notes" parent="0"/><mxCell id="tint-MBR-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="C-3bhk-floor"><mxGeometry x="350.50" y="240.00" width="305.50" height="307.00" as="geometry"/></mxCell><mxCell id="tint-MBR-1" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="C-3bhk-floor"><mxGeometry x="240.00" y="422.50" width="115.00" height="124.50" as="geometry"/></mxCell><mxCell id="tint-BATH1-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="C-3bhk-floor"><mxGeometry x="240.00" y="240.00" width="110.50" height="182.50" as="geometry"/></mxCell><mxCell id="tint-BR2-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="C-3bhk-floor"><mxGeometry x="656.00" y="240.00" width="322.00" height="307.00" as="geometry"/></mxCell><mxCell id="tint-LDK-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="C-3bhk-floor"><mxGeometry x="574.50" y="547.00" width="403.50" height="307.00" as="geometry"/></mxCell><mxCell id="tint-LOBBY-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FAF3E3;" vertex="1" parent="C-3bhk-floor"><mxGeometry x="458.50" y="547.00