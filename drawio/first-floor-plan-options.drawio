e=24;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="230.00" y="14.00" width="1500.00" height="34.00" as="geometry"/></mxCell><mxCell id="subtitle" value="Roof 48′-0″ × 30′-0″ · pillars 10″ × 10″ FIXED (locked, same positions as the rooftop file) · walls 10″ / partitions 4½″ · room sizes are clear sizes · scale 1 ft = 24 px, grid 6″ · furniture indicative" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=13;fontStyle=0;fontColor=#555555;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="230.00" y="48.00" width="1600.00" height="22.00" as="geometry"/></mxCell><mxCell id="v74" value="" style="rounded=0;html=1;fillColor=#1F2D3D;strokeColor=#000000;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="230.00" y="1060.00" width="20.00" height="20.00" as="geometry"/></mxCell><mxCell id="v75" value="Pillar (locked)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="256.00" y="1060.00" width="120.00" height="20.00" as="geometry"/></mxCell><mxCell id="v76" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#7B8189;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="380.00" y="1064.00" width="40.00" height="12.00" as="geometry"/></mxCell><mxCell id="v77" value="Wall 10″" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="426.00" y="1060.00" width="100.00" height="20.00" as="geometry"/></mxCell><mxCell id="v78" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#B3B8BE;" vertex="1" parent="C-3bhk-notes"><mxGeometry x="520.00" y="1067.00" width="40.00" height="6.00" as="geometry"/></mxCell><mxCell id="v79" value="Partition