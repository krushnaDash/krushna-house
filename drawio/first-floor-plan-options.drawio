h="60.00" height="20.00" as="geometry"/></mxCell><mxCell id="v70" value="" style="shape=mxgraph.floorplan.window;html=1;fillColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="E1-notes"><mxGeometry x="780.00" y="1065.00" width="40.00" height="10.00" as="geometry"/></mxCell><mxCell id="v71" value="Window" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="E1-notes"><mxGeometry x="826.00" y="1060.00" width="70.00" height="20.00" as="geometry"/></mxCell><mxCell id="v72" value="" style="shape=mxgraph.floorplan.doorRight;html=1;fillColor=#FFFFFF;strokeColor=#0B5FA5;strokeWidth=2;" vertex="1" parent="E1-notes"><mxGeometry x="910.00" y="1056.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="v73" value="Entrance door (the only one)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="E1-notes"><mxGeometry x="944.00" y="1060.00" width="330.00" height="20.00" as="geometry"/></mxCell><mxCell id="e74" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=1;dashed=1;dashPattern=4 3;" edge="1" parent="E1-notes"><mxGeometry relative="1" as="geometry"><mxPoint x="1310.00" y="1070.00" as="sourcePoint"/><mxPoint x="1350.00" y="1070.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v75" value="Wide opening (no door)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=11;fontStyle=0;fontColor=#1F2D3D;" vertex="1" parent="E1-notes"><mxGeometry x="1356.00" y="1060.00" width="200.00" height="20.00" as="geometry"/></mxCell><mxCell id="schedule" value="&lt;b&gt;Room schedule – carpet area&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr style=&quot;background-color:#E8EEF7;&quot;&gt;&lt;th align=&quot;left&quot;&gt;Room&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Clear size&lt;/th&gt;&lt;th&gt;sq ft&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MASTER BEDROOM&lt;/td&gt;&lt;td&gt;12′-4″ × 12′-0″ + 4′-4″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;168&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 1&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 2&lt;/td&gt;&lt;td&gt;12′-10″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;154&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DINING&lt;/td&gt;&lt;td&gt;16′-2″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;194&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LOBBY&lt;/td&gt;&lt;td&gt;4′-10″ × 4′-8″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;23&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KITCHEN&lt;/td&gt;&lt;td&gt;8′-6″ × 12′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;102&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 2&lt;/td&gt;&lt;td&gt;4′-6″ × 7′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BEDROOM 3&lt;/td&gt;&lt;td&gt;11′-8″ × 10′-0″ + 4′-4″ × 2′-4″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;126&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BATH 3&lt;/td&gt;&lt;td&gt;4′-0″ × 7′-4″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;29&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BALCONY&lt;/td&gt;&lt;td&gt;16′-0″ × 3′-10″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIVING&lt;/td&gt;&lt;td&gt;16′-0″ × 10′-0″&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;160&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Total (excl. balcony)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td align=&quot;right&quot;&gt;&lt;b&gt;1015&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="E1-notes"><mxGeometry x="230.00" y="1110.00" width="640.00" height="560.00" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Option E1 – the whole floor as one 3 BHK&lt;/b&gt;&lt;br&gt;• &lt;b&gt;One entrance&lt;/b&gt; ① – the only door on the front wall, beside the stair. No second front door and no connecting door.&lt;br&gt;• &lt;b&gt;One kitchen&lt;/b&gt; ⑤ at the west end (102 sq ft), window on the highway wall; Bath 2 sits between the kitchen and the dining, its door off the lobby ④.&lt;br&gt;• &lt;b&gt;Flow:&lt;/b&gt; entrance → living → wide opening ⑥ → dining → lobby → kitchen / Bath 2 / master.&lt;br&gt;• &lt;b&gt;Bedrooms along the back:&lt;/b&gt; master (NW, attached Bath 1), Bedroom 2 (middle), Bedroom 3 (NE, attached Bath 3, balcony ③).&lt;br&gt;• 1015 sq ft carpet + 61 sq ft balcony; living + dining 354 sq ft in one open run.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reading this plan&lt;/b&gt;&lt;br&gt;① entrance · ② existing stair (position assumed) · ③ balcony off Bedroom 3 · ④ lobby (three doors: master, kitchen, Bath 2; 23 sq ft, part of the dining floor) · ⑤ kitchen · ⑥ 9′-9″ wide opening in the C-line wall between dining and living.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules kept&lt;/b&gt;&lt;br&gt;• Left 4′ strip = baths, kitchen and windows only – no balcony. Every pillar sits inside a wall.&lt;br&gt;• Every habitable room has an external window; Bath 2 opens off the lobby, never through a bedroom; attached baths open only into their bedroom.&lt;br&gt;&lt;br&gt;&lt;b&gt;Colours&lt;/b&gt; – blue = bedrooms · peach = living / dining · yellow = kitchen · grey-blue = baths · green = balcony.&lt;br&gt;&lt;b&gt;Engineer to confirm&lt;/b&gt; – the C2–C3 opening needs a beam above it; cantilever, waterproofing and bye-law points as plan A." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;rounded=0;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="E1-notes"><mxGeometry x="920.00" y="1110.00" width="800.00" height="560.00" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="E2" name="E2 · Full 3 BHK (master suite, back strip enclosed)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="12" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1750" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="E2-floor" value="Floor tints (locked)" style="locked=1;" parent="0"/><mxCell id="E2-struct" value="Structure – pillars (locked) + walls" parent="0"/><mxCell id="E2-open" value="Doors &amp; windows" parent="0"/><mxCell id="E2-furn" value="Furniture &amp; fixtures (indicative)" parent="0"/><mxCell id="E2-label" value="Room labels" parent="0"/><mxCell id="E2-dims" value="Dimensions &amp; grid" parent="0"/><mxCell id="E2-notes" value="Title, legend, schedule, notes" parent="0"/><mxCell id="tint-MBR-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#E3EEF9;" vertex="1" parent="E2-floor"><mxGeometry x="350.50" y="240.00" width="305.50" height="307.00" as="geometry"/></mxCell><mxCell id="tint-MBR-1" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#E3EEF9;" vertex="1" parent="E2-floor"><mxGeometry x="240.00" y="422.50" width="115.00" height="124.50" as="geometry"/></mxCell><mxCell id="tint-BATH1-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#E6ECF1;" vertex="1" parent="E2-floor"><mxGeometry x="240.00" y="240.00" width="110.50" height="182.50" as="geometry"/></mxCell><mxCell id="tint-BR2-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#E3EEF9;" vertex="1" parent="E2-floor"><mxGeometry x="656.00" y="240.00" width="322.00" height="307.00" as="geometry"/></mxCell><mxCell id="tint-DIN-0" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#FBE9D2